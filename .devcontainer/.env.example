# devcontainer内でホストのDockerを使用する場合、環境に応じて設定

# Linux (native Docker) - デフォルト設定
# DOCKER_SOCK=/var/run/docker.sock

# Docker Desktop (Mac/Windows) - 通常は設定不要
# DOCKER_SOCK=/var/run/docker.sock

# Rancher Desktop (Mac)
# DOCKER_SOCK=$HOME/.rd/docker.sock

# Colima (Mac)
# DOCKER_SOCK=$HOME/.colima/default/docker.sock
# または
# DOCKER_SOCK=$HOME/.colima/docker.sock

# 使用方法:
# 1. このファイルを .env にコピー: cp .env.example .env
# 2. 使用している環境に合わせて DOCKER_SOCK のコメントを外す
# 3. devcontainerをリビルド
